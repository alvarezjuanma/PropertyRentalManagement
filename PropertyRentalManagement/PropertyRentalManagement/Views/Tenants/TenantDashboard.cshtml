@{
    ViewData["Title"] = "Tenant Dashboard";
}

<h2 class="text-center">Tenant Dashboard</h2>

<div class="tenant-info mt-4 p-3 bg-light rounded shadow-sm">
    <h4>Your Profile</h4>
    <p>Name: @Model.Name</p>
    <p>Email: @Model.Email</p>
    <p>Phone: @Model.Phone</p>
</div>

@* <!-- Sección para crear cuenta -->
<div class="tenant-section mt-4 p-3 bg-light rounded shadow-sm">
    <h3>Create an Account</h3>
    <a href="@Url.Action("Create", "Tenants")" class="btn btn-primary btn-block">Create Account</a>
</div>
 *@
<!-- Sección para ver apartamentos disponibles -->
<div class="tenant-section mt-4 p-3 bg-light rounded shadow-sm">
    <h3>View Available Apartments</h3>
    <a href="@Url.Action("ViewAvailableApartments", "Tenants")" class="btn btn-secondary btn-block">View Apartments</a>
</div>

<!-- Sección para agendar citas con el manager -->
<div class="tenant-section mt-4 p-3 bg-light rounded shadow-sm">
    <h3>Schedule an Appointment</h3>
    <a href="@Url.Action("Create", "Appointments")" class="btn btn-info btn-block">Schedule Appointment</a>
</div>

<!-- Sección para enviar mensajes al property manager -->
<div class="tenant-section mt-4 p-3 bg-light rounded shadow-sm">
    <h3>Send Messages to Property Manager</h3>
    <a href="@Url.Action("Create", "Messages")" class="btn btn-dark btn-block">Send Message</a>
</div>

<!-- Estilos CSS -->
<style>
    body {
        background-color: #f0f7f9;
    }

    .dashboard-title {
        font-size: 2.5em;
        color: #134567; 
        margin-bottom: 20px;
    }

    .tenant-section {
        background-color: #e5f1f6; 
        border-left: 5px solid #4b7d99; 
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }

    .btn {
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 16px;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #4b7d99;
        border: none;
    }

    .btn-secondary {
        background-color: #6ba6c7;
        border: none;
    }

    .btn-info {
        background-color: #a7d2eb;
        border: none;
    }

    .btn-dark {
        background-color: #134567;
        border: none;
        color: white;
    }

    .btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
</style>