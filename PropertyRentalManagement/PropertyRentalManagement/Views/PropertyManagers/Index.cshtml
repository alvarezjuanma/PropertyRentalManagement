@model IEnumerable<PropertyRentalManagement.Models.PropertyManager>

@{
    ViewData["Title"] = "Property Manager Index";
}

<h1>Property Manager Index</h1>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}


<p>
    <a asp-action="Create">Create New Property Manager</a>
    <a asp-action="ManagerDashboard" controller="PropertyManagers" class="btn btn-secondary">Manager Dashboard</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().User.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Owner.Name) <!-- Mostrar el nombre del Owner -->
            </th>
            <th>
                Buildings Count
            </th>
            <th>
                Apartments Count
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.User.UserId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Owner.Name) 
                </td>
                <td>
                    @item.Buildings.Count 
                </td>
                <td>
                    @item.Apartments.Count
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ManagerId">Edit</a> |
                    @* <a asp-action="Details" asp-route-id="@item.ManagerId">Details</a> | *@
                    <a asp-action="Delete" asp-route-id="@item.ManagerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
