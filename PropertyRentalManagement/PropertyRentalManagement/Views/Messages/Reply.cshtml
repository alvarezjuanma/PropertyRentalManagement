@model PropertyRentalManagement.Models.Message

@{
    ViewData["Title"] = "Reply Message";
}

<h2>Reply Message</h2>

<form asp-action="Reply" method="post">
    <div class="form-group">
        <label asp-for="Recipient"></label>
        <input asp-for="Recipient" class="form-control" type="email" required readonly />
        <span asp-validation-for="Recipient" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Subject"></label>
        <input asp-for="Subject" class="form-control" type="text" required />
        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Content"></label>
        <textarea asp-for="Content" class="form-control" rows="5" required></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Send Reply</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
