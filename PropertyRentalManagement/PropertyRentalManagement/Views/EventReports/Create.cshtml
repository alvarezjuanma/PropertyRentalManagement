@model PropertyRentalManagement.Models.EventReport


@{
    ViewData["Title"] = "Create Event Report";
}

<h2>Create Event Report</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Status" class="control-label"></label>
        <select asp-for="Status" class="form-control">
            <option>Pending</option>
            <option>In Progress</option>
            <option>Resolved</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TenantId" class="control-label">Assign Tenant (Optional)</label>
        <select asp-for="TenantId" class="form-control">
            <option value="">-- Select Tenant --</option>
            @foreach (var tenant in ViewBag.Tenants)
            {
                <option value="@tenant.TenantId">@tenant.Name</option>
            }
        </select>
        <span asp-validation-for="TenantId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Create Report</button>
</form>
