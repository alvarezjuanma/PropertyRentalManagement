@model IEnumerable<PropertyRentalManagement.Models.PropertyOwner>

@{
    ViewData["Title"] = "Index";
}

<h1>Property Owners</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.User.UserId) 
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.OwnerId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.OwnerId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.OwnerId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


}