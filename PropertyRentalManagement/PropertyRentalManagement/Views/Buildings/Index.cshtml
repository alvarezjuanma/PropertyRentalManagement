@model IEnumerable<PropertyRentalManagement.Models.Buildings>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
    <a asp-action="ManagerDashboard" controller="PropertyManagers" class="btn btn-secondary">Manager Dashboard</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                Manager Full Name
            </th>
            <th>
                Manager Email
            </th>
            <th>
                Manager Phone
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>Calle
                    @Html.DisplayFor(modelItem => item.Manager.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Manager.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Manager.Phone)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.BuildingId">Edit</a> |
                  @*   <a asp-action="Details" asp-route-id="@item.BuildingId">Details</a> | *@
                    <a asp-action="Delete" asp-route-id="@item.BuildingId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

